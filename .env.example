# Supabase Credentials for GeoCam (Copia este archivo a .env y coloca tus valores reales)
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# La API key de Gemini NO va aquí. Todo lo EXPO_PUBLIC_* queda en texto plano dentro de la app.
# Es un secreto de las Edge Functions de Supabase:
#   npx supabase secrets set GEMINI_API_KEY=...
# Opcionales, también como secretos: GEMINI_MODEL, GEMINI_MODEL_RESPALDO y LIMITE_DIARIO.
